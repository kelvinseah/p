# ENG1104 Doxygen configuration
#
# Generate the documentation with:
#
#     doxygen Doxyfile
#
# then open  docs/html/index.html
#
# This file is deliberately short. A default Doxyfile produced by
# `doxygen -g` is around 2500 lines; everything not listed here keeps its
# default value, and the settings below are the ones that matter for a small
# embedded project.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "ENG1104 Firmware"
PROJECT_BRIEF          = "Discover Programming - embedded C for the Pico WH"
PROJECT_NUMBER         = "AY26/27 T1"
OUTPUT_DIRECTORY       = docs

#---------------------------------------------------------------------------
# What to read
#---------------------------------------------------------------------------
INPUT                  = .
FILE_PATTERNS          = *.c *.h *.cpp *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */docs/*

#---------------------------------------------------------------------------
# How much to document
#---------------------------------------------------------------------------
# Include everything, including static helpers -- on a small firmware the
# internal functions are exactly the ones a reader needs explained.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES

# Warn about anything undocumented. Treat these warnings as a checklist.
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen-warnings.txt

#---------------------------------------------------------------------------
# Presentation
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES          # clickable source next to the docs
INLINE_SOURCES         = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES          # first sentence becomes the brief
ALPHABETICAL_INDEX     = YES

# Show the value of #defines -- useful when the register constants are the
# whole point of the header.
MAX_INITIALIZER_LINES  = 10

#---------------------------------------------------------------------------
# Diagrams (only if Graphviz is installed)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
